# ===========================================================================
# ZERO-CONFIG DEMO (T067)
#
# ONE variable replaces every credential below it. `DEMO_MODE=true` runs the whole
# portal with no service account, no spreadsheet, no n8n, no OAuth client, no
# passcode hash and no session secret:
#
#   session  -> a synthetic hr_admin, so there is no sign-in
#   roster   -> seeded in-memory employees (1401-1403, plus the real malformed row)
#   webhooks -> canned responses; no socket is ever opened
#   audit    -> kept in memory, never appended to a sheet
#
# Everything else is the real code path — same schemas, ingest, classifiers and
# components — so a demo bug is a real bug. Nothing can reach the network, and a
# hire created in the demo disappears on restart.
#
# Off unless the value is exactly "true". NEVER enable this on a real deployment.
# ===========================================================================
DEMO_MODE=false

# Server-side only. NEVER prefix any of these with NEXT_PUBLIC_ —
# that would ship the value to the browser bundle and break the
# "no credentials to the client" contract (plan.md §Security).
N8N_BASE_URL=https://ashtosh.app.n8n.cloud

SHEET_ID=1FoGZrSYydXmoHnMLfNdqlGa1GOpHdqvwLGOHW8XQz5o
GOOGLE_SERVICE_ACCOUNT_JSON=
AUDIT_SHEET_ID=

SESSION_SECRET=
SESSION_SECRET_MIN_LENGTH=32

# ---------------------------------------------------------------------------
# Sign-in (T083)
#
# The ONLY way to obtain a session outside local development. Without these the
# app still runs, but /login says so plainly and every API returns 401 — the
# portal is unusable, which is the correct fail-closed behaviour.
#
# Create an OAuth 2.0 Web Client in Google Cloud Console:
#   Authorized redirect URI MUST match GOOGLE_OAUTH_REDIRECT_URI EXACTLY,
#   including scheme, port and trailing slash. A mismatch is the single most
#   common cause of a silent OAuth failure.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Access authority. Comma or whitespace separated; case-insensitive.
#
# These are the ONLY sources of role. Roles are never read from the Google
# account, a form field, or the sheet's `role` column — that column holds job
# TITLES ("Developer - Lead"), and it is remotely writable by the onboarding
# webhook, so an access role there would be self-granting.
#
# Anyone whose address appears on neither list is a `new_hire` scoped to their own
# roster row, looked up by emailID. Anyone on neither list NOR the roster is
# refused sign-in.
HR_ADMIN_EMAILS=
MANAGER_EMAILS=

# Fallback sign-in that needs NO Google Cloud project — required in practice,
# because registering an OAuth client needs Cloud project permissions that a
# Workspace admin holds and an individual operator does not.
#
# Store the HASH printed by `npm run auth:passcode`, never the passcode itself, so
# a leaked config file does not hand over a login. Rerun the script to rotate; the
# old hash stops working immediately.
#
# A passcode grants a ROLE, not a person: there is no `selfId`, so it cannot open an
# individual employee's own record. Per-employee self-service still needs Google OAuth.
#
# Attempts are rate limited to 5 per 15 minutes per client address.
HR_ADMIN_PASSCODE_HASH=
MANAGER_PASSCODE_HASH=

# Read range. Pinning Sheet1!A1:J is load-bearing: Sheet2 is a
# byte-identical mirror and an unpinned read doubles every employee.
SHEET_RANGE=Sheet1!A1:J

# Gates POST /api/admin/new-hire. Off until you deliberately enable it: the
# endpoint creates real employee records and the workflow emails them.
ADMIN_CONTRACT_VERIFIED=false

# ---------------------------------------------------------------------------
# New-hire provisioning safety (T065)
#
# THE IMPORTANT ONE. With this `true` a submit is fully validated and mapped, then
# stops: no roster row, no audit row, no welcome email. Nothing a user can do on
# the Provision New Hire page can reach the live sheet.
#
# Defaults to safe: the code treats anything other than "true" as OFF, so set this
# to `false` EXPLICITLY when you actually intend to create people. Leaving it unset
# on a fresh deploy means provisioning cannot write, which is the correct failure.
# ---------------------------------------------------------------------------
NEW_HIRE_DRY_RUN=true

# Demo switch. `true` lets the Provision New Hire page AND its endpoint run with
# no sign-in, so a POC can be demonstrated without logging in first. Off by
# default; only the literal `true` enables it.
#
# It bypasses AUTHENTICATION ONLY. Schema validation, the duplicate-request guard,
# ADMIN_CONTRACT_VERIFIED and NEW_HIRE_DRY_RUN all still apply — and the audit row
# is written as `poc@local`, never from the request body.
#
# Leave this OFF anywhere real: it is the only unauthenticated write path in the
# app, and every other route still requires a session.
NEW_HIRE_POC_MODE=false

# Per-employee onboarding-progress reads. Off by default because the fan-out costs
# one n8n webhook call per roster row; retained as a kill switch, since turning it
# off degrades to reporting progress as unavailable rather than failing.
TRACKER_PROGRESS_FANOUT=false

# Fan-out concurrency for the tracker. Per n8n webhook capacity, not quota.
TRACKER_FANOUT_CONCURRENCY=6
TRACKER_ROW_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Upstream Apps Script webhook (n8n calls this; the portal does not).
# The token is appended per request as ?token=... and is stored ONLY in the
# Apps Script's Script Properties + the n8n credential store. Never put it here
# and never prefix this with NEXT_PUBLIC_.
#
# The URL alone grants nothing — the shared secret is the only credential.
# Apps Script always answers HTTP 200; branch on the body's `status` field
# (success | not_found | error), not the HTTP code. A bare 404 means throttled
# or not yet propagated, and is worth a retry.
# See scripts/apps-script/DEPLOY.md §Runtime behaviour n8n must respect.
# ---------------------------------------------------------------------------
APPS_SCRIPT_ID=1E-xQ67NPSJdmfMoMkbsmzYYS4tPfq6C3q5ZdboIXDTDgXAjrFcv1SoAk
ONBOARDING_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbxDRayH4bMlPiJoj1xj_8s35b3mdajQvQ6OEbIPJAkRjA354N_mcqswK03IJQUCGtCp/exec